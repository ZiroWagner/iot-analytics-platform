{
  "name": "iot-analytics-platform",
  "version": "1.0.0",
  "private": true,
  "description": "IoT Analytics Platform Monorepo Root",
  "scripts": {
    "perf:stack:up": "docker compose -f infra/docker-compose.perf.yml up -d",
    "perf:stack:down": "docker compose -f infra/docker-compose.perf.yml down -v",
    "perf:stack:logs": "docker compose -f infra/docker-compose.perf.yml logs -f",
    "test:perf": "node scripts/dev-test.js perf",
    "test:perf:docker": "node scripts/dev-test.js perf --docker",
    "test:perf:smoke": "node scripts/dev-test.js perf --scenario smoke --influxdb http://localhost:8086/k6",
    "test:perf:load": "node scripts/dev-test.js perf --scenario load --influxdb http://localhost:8086/k6",
    "test:perf:stress": "node scripts/dev-test.js perf --scenario stress --influxdb http://localhost:8086/k6",
    "test:perf:spike": "node scripts/dev-test.js perf --scenario spike --influxdb http://localhost:8086/k6",
    "test:perf:soak": "node scripts/dev-test.js perf --scenario soak --influxdb http://localhost:8086/k6",
    "test:perf:full": "node scripts/dev-test.js perf --scenario load --influxdb http://localhost:8086/k6 && node scripts/dev-test.js perf --scenario stress --influxdb http://localhost:8086/k6 && node scripts/dev-test.js perf --scenario spike --influxdb http://localhost:8086/k6 && node scripts/dev-test.js perf --scenario soak --influxdb http://localhost:8086/k6",
    "test:security": "node scripts/dev-test.js security",
    "test:all": "node scripts/dev-test.js all --docker"
  }
}
